{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=netquestai.db"
  },
  "JwtSettings": {
    "SecretKey": "REPLACE_WITH_A_SECURE_256_BIT_SECRET_KEY_IN_PRODUCTION",
    "Issuer": "NetQuestAI",
    "Audience": "NetQuestAI-Client",
    "ExpiryDays": "7"
  }
}
