# Normalize line endings to LF in repository, convert to CRLF on Windows checkout
* text=auto eol=lf

# Force LF for these file types regardless of OS
*.cs    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.csproj text eol=lf
*.sln   text eol=lf
*.svg   text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.ico   binary
*.webp  binary
